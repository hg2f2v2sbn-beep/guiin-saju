      "expected": "reconciliation finds mismatch"
    },
    {
      "id": "REFUND-01",
      "scenario": "refund succeeds but entitlement remains",
      "expected": "critical reconciliation issue"
    },
    {
      "id": "REFUND-02",
      "scenario": "clover already used then refund requested",
      "expected": "automatic refund blocked"
    },
    {
      "id": "AUTH-01",
      "scenario": "expired session",
      "expected": "401"
    },
    {
      "id": "AUTH-02",
      "scenario": "revoked session token replay",
      "expected": "401"
    },
    {
